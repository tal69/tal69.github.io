source "https://rubygems.org"

# GitHub Pages-compatible Jekyll. Pin to the version used by Pages for
# painless deploys; bump as needed.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Required on macOS / newer Ruby
gem "webrick", "~> 1.8"
gem "csv"
gem "logger"
gem "base64"
